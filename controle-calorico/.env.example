ANTHROPIC_API_KEY=
API_PORT=3001
# Postgres connection string. On Railway, add the Postgres addon to the project
# and it injects DATABASE_URL automatically. For local dev, point at a local
# Postgres instance, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/controle_calorico
DATABASE_URL=

# Google Health API (Fitbit sync) — see the setup guide in the project README
# or ask Claude for the Google Cloud Console steps. Redirect URI must match
# exactly what's configured in the OAuth client (Web application type):
#   <your-app-url>/api/health-connect/callback
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=
